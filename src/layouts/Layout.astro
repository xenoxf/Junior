---
import { info } from '../lib/info'
import '../styles/base.css'

const title = `${info.name} · ${info.title}`
const description = info.shortBio
const url = 'https://xenooxf.vercel.app'
const knowsAbout = [
  'JavaScript', 'TypeScript', 'Java', 'React', 'Next.js', 'Astro',
  'SolidJS', 'Tailwind CSS', 'Node.js', 'Express', 'TypeORM', 'Prisma',
  'Git', 'Vercel', 'Vite', 'Framer Motion',
]
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={info.fullName} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: info.fullName,
      alternateName: info.aliases,
      jobTitle: info.title,
      description: info.shortBio,
      url,
      email: info.email,
      address: { '@type': 'PostalAddress', addressLocality: info.location, addressCountry: 'CO' },
      sameAs: [info.githubUrl, info.whatsappUrl, `mailto:${info.email}`],
      knowsAbout,
    })} />
  </head>
  <body>
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
    <slot />
  </body>
</html>
