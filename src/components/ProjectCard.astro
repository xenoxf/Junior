---
import type { Project } from '../types'
import '../styles/project-card.css'

interface Props {
  project: Project
  index: number
}

const { project, index } = Astro.props
const num = String(index).padStart(2, '0')
const detailUrl = `/proyecto/${project.id}`
---

<article class="card" data-category={project.category}>
  <span class="card-index">{num}</span>
  <a class="card-media-link" href={detailUrl} aria-label={`Ver caso técnico de ${project.name}`}>
    {
      project.image && (
        <div class="card-media">
          <img src={project.image} alt={`Captura de ${project.name}`} loading="lazy" decoding="async" onerror="this.closest('.card-media')?.remove()" />
        </div>
      )
    }
  </a>
  <div class="card-body">
    <h3 class="card-name">
      <a href={detailUrl}>{project.name}</a>
    </h3>
    <p class="card-desc">{project.description}</p>

    <div class="card-links">
      <a href={detailUrl} class="card-details-link">Ver caso técnico →</a>
      {project.githubUrl && <a href={project.githubUrl} target="_blank" rel="noopener">Código</a>}
      {project.demoUrl && <a href={project.demoUrl} target="_blank" rel="noopener">Demo</a>}
    </div>
  </div>
</article>
